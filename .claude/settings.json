{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" pull --ff-only -q 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Pulling latest from GitHub..."
          }
        ]
      }
    ]
  }
}
